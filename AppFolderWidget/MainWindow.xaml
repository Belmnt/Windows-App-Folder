<Window x:Class="AppFolderWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppFolderWidget"
        mc:Ignorable="d"
        
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        
        Title="MainWindow" Height="450" Width="800">
    <Border Background="{StaticResource WidgetBackgroundBrush}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Mi Casilla"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                    <Button x:Name="OptionsButton"
                            Content="⋮"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="25"
                            Height="25"
                            FontSize="18"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OptionsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="RootGrid">
                                    <Ellipse x:Name="BgEllipse" Fill="{TemplateBinding Background}"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BgEllipse" Property="Fill" Value="{StaticResource ButtonHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BgEllipse" Property="Fill" Value="{StaticResource ButtonPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OptionsMenu"
                                         Closed="OptionsMenu_Closed"
                                         Style="{StaticResource WidgetContexMenuStyle}"
                                         Background="#F21E1E1E"
                                         BorderBrush="{StaticResource ButtonHoverBrush}"
                                         BorderThickness="1"
                                         HasDropShadow="False">
                                <MenuItem Header="Añadir" IsEnabled="False" Style="{StaticResource WidgetMenuItemStyle}"/>
                                <MenuItem Header="Editar" IsEnabled="False" Style="{StaticResource WidgetMenuItemStyle}"/>
                                <Separator/>
                                <MenuItem Header="Eliminar" Click="Eliminar_Click" Style="{StaticResource WidgetMenuItemStyle}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding AllApps}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListItem_MouseDoubleClick"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{StaticResource ItemSelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{StaticResource ItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="80">
                            <Image Source="{Binding Icon}"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxHeight="32"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
